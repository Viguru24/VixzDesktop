<Window x:Class="VixzDesktop.PopOutPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Vixz - Floating Player"
        Height="400" Width="600"
        MinHeight="260" MinWidth="380"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- Outer Floating Glass Container -->
    <Border Background="{StaticResource BgDarkPrimary}"
            BorderBrush="{StaticResource AccentGold}"
            BorderThickness="1.5"
            CornerRadius="14"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Mini Header Bar -->
                <RowDefinition Height="36"/>
                <!-- Video WebView2 Container -->
                <RowDefinition Height="*"/>
                <!-- Mini Utility Deck -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. DRAGGABLE TITLE BAR -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgDarkSecondary}"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0,0,0,1"
                    MouseDown="TitleBar_MouseDown">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⧉ " Foreground="{StaticResource AccentGold}" FontSize="13" FontWeight="Bold"/>
                        <TextBlock x:Name="MiniVideoTitle" Text="Vixz Floating Player" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                    </StackPanel>

                    <!-- Header Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Pin / Topmost Toggle -->
                        <Button x:Name="PinBtn" Content="📌" Style="{StaticResource IconActionButton}" Width="24" Height="24" ToolTip="Toggle Always-On-Top" Margin="0,0,4,0" Click="PinBtn_Click"/>
                        <!-- Dock Back / Restore to Main Window -->
                        <Button Content="🗖" Style="{StaticResource IconActionButton}" Width="24" Height="24" ToolTip="Dock Back to Main Window" Margin="0,0,4,0" Click="DockBackBtn_Click"/>
                        <!-- Close Window -->
                        <Button Content="✕" Style="{StaticResource IconActionButton}" Width="24" Height="24" ToolTip="Close Mini Player" Click="CloseBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. VIDEO PLAYER CONTAINER -->
            <Grid Grid.Row="1" Background="Black">
                <wv2:WebView2 x:Name="MiniWebView"/>
            </Grid>

            <!-- 3. MINI UTILITY DECK & CONTROLS -->
            <Border Grid.Row="2" Background="{StaticResource BgDarkSecondary}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Seek & Play Controls -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="-10s" Style="{StaticResource GlassButton}" FontSize="10" Padding="5,3" Margin="0,0,3,0" Click="SeekMinus10_Click"/>
                        <Button Content="-5s" Style="{StaticResource GlassButton}" FontSize="10" Padding="5,3" Margin="0,0,3,0" Click="SeekMinus5_Click"/>
                        <Button x:Name="PlayPauseBtn" Content="⏯️" Style="{StaticResource IconActionButton}" Width="28" Height="28" Margin="0,0,3,0" Click="PlayPause_Click"/>
                        <Button Content="+5s" Style="{StaticResource GlassButton}" FontSize="10" Padding="5,3" Margin="0,0,3,0" Click="SeekPlus5_Click"/>
                        <Button Content="+10s" Style="{StaticResource GlassButton}" FontSize="10" Padding="5,3" Margin="0,0,6,0" Click="SeekPlus10_Click"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Screenshot -->
                        <Button Content="📸" Style="{StaticResource IconActionButton}" Width="28" Height="28" ToolTip="Take Screenshot" Margin="0,0,3,0" Click="Screenshot_Click"/>
                        <!-- Sleep Timer -->
                        <Button Content="🌙" Style="{StaticResource IconActionButton}" Width="28" Height="28" ToolTip="Sleep Timer (30m)" Margin="0,0,3,0" Click="Sleep_Click"/>
                        <!-- Favorite -->
                        <Button x:Name="FavBtn" Content="⭐" Style="{StaticResource IconActionButton}" Width="28" Height="28" ToolTip="Favorite" Margin="0,0,3,0" Click="Favorite_Click"/>
                        <!-- Next Video -->
                        <Button Content="⏭️" Style="{StaticResource IconActionButton}" Width="28" Height="28" ToolTip="Next Video" Click="NextVideo_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
