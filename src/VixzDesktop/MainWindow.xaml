<Window x:Class="VixzDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Vixz - Premium YouTube Desktop"
        Height="780" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#0B0B0E"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- Outer Glass Window Container -->
    <Border Background="{StaticResource BgDarkPrimary}"
            BorderBrush="{StaticResource BorderSubtle}"
            BorderThickness="1"
            CornerRadius="14">
        
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="46"/>
                <!-- Main Content Area -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. CUSTOM FRAMELESS TITLE BAR -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgDarkSecondary}"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0"
                    MouseDown="TitleBar_MouseDown">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <!-- App Logo & Title -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Top Search Bar -->
                        <ColumnDefinition Width="*"/>
                        <!-- Window Controls -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Logo & Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentRed}" Width="28" Height="28" CornerRadius="8">
                            <TextBlock Text="▶" Foreground="White" FontSize="14" FontWeight="Bold" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </Border>
                        <TextBlock Text="Vixz" Foreground="White" FontSize="17" FontWeight="Bold" 
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <Border Background="#25FFFFFF" CornerRadius="6" Margin="8,0,0,0" Padding="6,2">
                            <TextBlock Text="DESKTOP" Foreground="{StaticResource AccentGold}" FontSize="9" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Top Search Bar -->
                    <Border Grid.Column="1" 
                            Background="#181820" 
                            BorderBrush="{StaticResource BorderSubtle}" 
                            BorderThickness="1" 
                            CornerRadius="20"
                            Height="34"
                            MaxWidth="520"
                            Margin="30,0"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="SearchBox"
                                     Background="Transparent"
                                     Foreground="White"
                                     BorderThickness="0"
                                     FontSize="13"
                                     VerticalAlignment="Center"
                                     Margin="14,0,0,0"
                                     KeyDown="SearchBox_KeyDown"
                                     CaretBrush="{StaticResource AccentRed}"/>

                            <TextBlock Text="Search videos, channels, topics..." 
                                       Foreground="{StaticResource TextMuted}" 
                                       FontSize="13" 
                                       VerticalAlignment="Center" 
                                       Margin="14,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Grid.Column="1"
                                    Content="🔍"
                                    Foreground="White"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="36"
                                    Height="30"
                                    Cursor="Hand"
                                    Click="SearchButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- Window Action Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- ✨ AI Copilot Button -->
                        <Button x:Name="AiCopilotBtn"
                                Content="✨ AI Copilot"
                                Style="{StaticResource GlassButton}"
                                Padding="10,4" Margin="0,0,10,0"
                                ToolTip="Open AI Copilot &amp; Assistant"
                                Click="AiCopilotBtn_Click"/>

                        <!-- Always-on-Top Pin Button -->
                        <Button x:Name="PinButton"
                                Content="📌"
                                Style="{StaticResource IconActionButton}"
                                Width="30" Height="30" Margin="0,0,6,0"
                                ToolTip="Always on Top (T)"
                                Click="PinButton_Click"/>

                        <!-- Minimize -->
                        <Button Content="─"
                                Style="{StaticResource IconActionButton}"
                                Width="30" Height="30" Margin="0,0,4,0"
                                Click="MinimizeButton_Click"/>

                        <!-- Maximize -->
                        <Button x:Name="MaximizeBtn"
                                Content="▢"
                                Style="{StaticResource IconActionButton}"
                                Width="30" Height="30" Margin="0,0,4,0"
                                Click="MaximizeButton_Click"/>

                        <!-- Close -->
                        <Button Content="✕"
                                Style="{StaticResource IconActionButton}"
                                Width="30" Height="30"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. MAIN BODY (Sidebar + Feed/Player View + AI Copilot) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Left Sidebar Navigation -->
                    <ColumnDefinition Width="210" x:Name="SidebarCol"/>
                    <!-- Main Content View -->
                    <ColumnDefinition Width="*"/>
                    <!-- Dedicated AI Copilot Panel (Zero Overlap with Player Controls) -->
                    <ColumnDefinition Width="Auto" x:Name="AiDrawerCol"/>
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar -->
                <Border Grid.Column="0" 
                        Background="{StaticResource BgDarkSecondary}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,14">
                    <Grid Margin="12,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Nav Menu Items -->
                        <StackPanel Grid.Row="0">
                            <Button x:Name="NavHomeBtn" Content="🏠   Home Feed" Style="{StaticResource GlassButton}" Margin="0,0,0,5" HorizontalContentAlignment="Left" Click="NavHome_Click"/>
                            <Button x:Name="NavSubscribedBtn" Content="🔔   Subscriptions" Style="{StaticResource GlassButton}" Margin="0,0,0,5" HorizontalContentAlignment="Left" Click="NavSubscriptions_Click"/>
                            <Button x:Name="NavTrendingBtn" Content="🔥   Trending" Style="{StaticResource GlassButton}" Margin="0,0,0,5" HorizontalContentAlignment="Left" Click="NavTrending_Click"/>
                            <Button x:Name="NavFavBtn" Content="⭐   Favorites" Style="{StaticResource GlassButton}" Margin="0,0,0,5" HorizontalContentAlignment="Left" Click="NavFavorites_Click"/>
                            <Button x:Name="NavWatchLaterBtn" Content="🕒   Watch Later" Style="{StaticResource GlassButton}" Margin="0,0,0,5" HorizontalContentAlignment="Left" Click="NavWatchLater_Click"/>
                            <Button x:Name="NavHistoryBtn" Content="📜   History" Style="{StaticResource GlassButton}" Margin="0,0,0,5" HorizontalContentAlignment="Left" Click="NavHistory_Click"/>
                        </StackPanel>

                        <!-- Subscribed Creators List Section in Sidebar -->
                        <Border Grid.Row="1" Background="#14141D" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="8,8,4,8" Margin="0,6,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="SubscribersHeader" Text="👤 Subscriptions" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="4,0,0,6"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="SubscribedChannelsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding}" Style="{StaticResource GlassButton}" HorizontalContentAlignment="Left" FontSize="11" Padding="6,4" Margin="0,1" Click="ChannelFilter_Click"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Active Screenshot Folder Section -->
                        <Border Grid.Row="2" Background="#16161F" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="12">
                            <StackPanel>
                                <TextBlock Text="📁 Screenshot Folder" Foreground="{StaticResource AccentGold}" FontSize="12" FontWeight="Bold"/>
                                <TextBlock x:Name="CurrentFolderText" Text="Pictures\Vixz\Default" Foreground="{StaticResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Change" Style="{StaticResource GlassButton}" FontSize="11" Padding="8,4" Click="ChangeFolder_Click"/>
                                    <Button Content="Open ↗" Style="{StaticResource GlassButton}" FontSize="11" Padding="8,4" Margin="6,0,0,0" Click="OpenFolder_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right Main Content Area -->
                <Grid Grid.Column="1">
                    
                    <!-- A. VIDEO FEED VIEW (Cards Grid) -->
                    <Grid x:Name="FeedView" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Feed Title / Status Bar & Search Filter Bar -->
                        <Grid Grid.Row="0" Margin="24,14,24,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock x:Name="FeedTitleText" Text="Recommended Feed" Foreground="White" FontSize="20" FontWeight="Bold"/>
                                <ProgressBar x:Name="LoadingSpinner" IsIndeterminate="True" Width="120" Height="4" HorizontalAlignment="Right" Visibility="Collapsed"/>
                            </Grid>

                            <!-- Search & Filter Deck: Time, Date, Sort By -->
                            <Border Grid.Row="1" Margin="0,10,0,0" Background="#161622" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- 📅 Upload Date Filter -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                                        <TextBlock Text="📅 Date:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="DateFilterCombo" Width="115" Height="26" Style="{StaticResource ModernComboBoxStyle}" SelectionChanged="FilterOrSort_Changed">
                                            <ComboBoxItem Content="Any Time" IsSelected="True" Tag=""/>
                                            <ComboBoxItem Content="Last Hour" Tag="hour"/>
                                            <ComboBoxItem Content="Today" Tag="today"/>
                                            <ComboBoxItem Content="This Week" Tag="week"/>
                                            <ComboBoxItem Content="This Month" Tag="month"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- ⏱️ Duration Filter -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                                        <TextBlock Text="⏱️ Length:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="DurationFilterCombo" Width="125" Height="26" Style="{StaticResource ModernComboBoxStyle}" SelectionChanged="FilterOrSort_Changed">
                                            <ComboBoxItem Content="Any Duration" IsSelected="True" Tag=""/>
                                            <ComboBoxItem Content="&lt; 4 min (Short)" Tag="short"/>
                                            <ComboBoxItem Content="4 - 20 min (Med)" Tag="medium"/>
                                            <ComboBoxItem Content="&gt; 20 min (Long)" Tag="long"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- ⚡ Sort By Filter -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                                        <TextBlock Text="⚡ Sort:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="SortByFilterCombo" Width="120" Height="26" Style="{StaticResource ModernComboBoxStyle}" SelectionChanged="FilterOrSort_Changed">
                                            <ComboBoxItem Content="Relevance" IsSelected="True" Tag=""/>
                                            <ComboBoxItem Content="Newest First" Tag="latest"/>
                                            <ComboBoxItem Content="Most Viewed" Tag="views"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Filter Buttons -->
                                    <Button Content="Apply Filters" Style="{StaticResource GlassButton}" FontSize="11" Padding="10,4" Margin="0,2,6,2" Click="ApplyFiltersBtn_Click"/>
                                    <Button Content="Reset" Style="{StaticResource GlassButton}" FontSize="11" Padding="8,4" Margin="0,2,0,2" Click="ResetFiltersBtn_Click"/>
                                </WrapPanel>
                            </Border>
                        </Grid>

                        <!-- Video Grid Scroll Viewer -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,0,8,12">
                            <ItemsControl x:Name="VideoItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="280" Height="240" Margin="8" Background="#15151D" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Cursor="Hand" MouseDown="VideoCard_MouseDown">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#22222E"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource BorderHover}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="158"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <!-- Thumbnail Image -->
                                                <Border Grid.Row="0" CornerRadius="12,12,0,0" ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                                        <!-- Duration Badge -->
                                                        <Border Background="#CC000000" CornerRadius="4" Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                                                            <TextBlock Text="{Binding DurationText}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- Video Info -->
                                                <StackPanel Grid.Row="1" Margin="10,8,10,6">
                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="36"/>
                                                    <TextBlock Text="{Binding SubtitleText}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- B. HIGH-PERFORMANCE VIDEO PLAYER VIEW -->
                    <Grid x:Name="PlayerView" Visibility="Collapsed" Background="#09090C">
                        <Grid.RowDefinitions>
                            <!-- Player Deck + Video Frame -->
                            <RowDefinition Height="*"/>
                            <!-- Below Player Controls & Video Info -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Video Player Area -->
                        <Grid Grid.Row="0" x:Name="PlayerContainer">
                            <!-- WebView2 Embedded Player (Hardware Accelerated) -->
                            <wv2:WebView2 x:Name="VideoWebView"/>

                            <!-- Top-Right Translucent Sleep Timer Countdown Badge -->
                            <Border x:Name="SleepCountdownBadge"
                                    Background="#60000000"
                                    BorderBrush="{StaticResource AccentGold}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="10,4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,16,16,0"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌙 " FontSize="12"/>
                                    <TextBlock x:Name="SleepCountdownText" Text="29:45" Foreground="{StaticResource AccentGold}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <!-- Toast / Notification Chip -->
                            <Border x:Name="PlayerToast"
                                    Background="#E0000000"
                                    BorderBrush="{StaticResource AccentGold}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="16,8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="0,20,0,0"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="PlayerToastText" Text="Screenshot saved 📸" Foreground="White" FontSize="13" FontWeight="Bold"/>
                            </Border>

                            <!-- Camera Shutter Flash Effect Overlay -->
                            <Border x:Name="ShutterFlash" Background="White" Opacity="0" IsHitTestVisible="False"/>

                            <!-- Center 1-Click Resume Sleep Timer Pill -->
                            <Border x:Name="ResumeSleepPill"
                                    Background="#E0111116"
                                    BorderBrush="{StaticResource AccentGold}"
                                    BorderThickness="1.5"
                                    CornerRadius="24"
                                    Padding="20,12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    MouseDown="ResumeSleepPill_MouseDown"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌙 " FontSize="16"/>
                                    <TextBlock x:Name="ResumeSleepText" Text="Resume for 30m" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Below Video Details & Desktop Utility Deck -->
                        <Border Grid.Row="1" Background="{StaticResource BgDarkSecondary}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="18,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Video Title, Channel & Back Button -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="◀ Back" Style="{StaticResource GlassButton}" Padding="10,6" Margin="0,0,12,0" Click="BackToFeed_Click"/>

                                    <!-- Quick Seek Controls -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <Button Content="-10s" Style="{StaticResource GlassButton}" ToolTip="Seek Back 10s (J)" FontSize="11" Padding="6,4" Margin="0,0,3,0" Click="SeekMinus10_Click"/>
                                        <Button Content="-5s" Style="{StaticResource GlassButton}" ToolTip="Seek Back 5s (Left)" FontSize="11" Padding="6,4" Margin="0,0,3,0" Click="SeekMinus5_Click"/>
                                        <Button Content="+5s" Style="{StaticResource GlassButton}" ToolTip="Seek Forward 5s (Right)" FontSize="11" Padding="6,4" Margin="0,0,3,0" Click="SeekPlus5_Click"/>
                                        <Button Content="+10s" Style="{StaticResource GlassButton}" ToolTip="Seek Forward 10s (L)" FontSize="11" Padding="6,4" Margin="0,0,8,0" Click="SeekPlus10_Click"/>
                                    </StackPanel>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="CurrentVideoTitle" Text="Video Title" Foreground="White" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock x:Name="CurrentVideoChannel" Text="Channel Name" Foreground="{StaticResource TextSecondary}" FontSize="11.5" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="CurrentVideoDate" Text="" Foreground="{StaticResource AccentGold}" FontSize="11.5" FontWeight="Bold" Margin="4,0,0,0"/>
                                            <TextBlock x:Name="CurrentVideoViews" Text="" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right: Desktop Action Utility Buttons & Status -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Dynamic Toast / Feedback Pill -->
                                    <Border x:Name="BottomToastPill" Background="#282838" BorderBrush="{StaticResource AccentGold}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock x:Name="BottomToastText" Text="Screenshot saved 📸" Foreground="{StaticResource AccentGold}" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- 1. 📸 Screenshot Button -->
                                    <Button x:Name="ScreenshotBtn" Content="📸" Style="{StaticResource IconActionButton}" ToolTip="Take Screenshot (S)" Margin="0,0,5,0" Click="ScreenshotBtn_Click"/>

                                    <!-- 2. 📥 Download Video (MP4) -->
                                    <Button x:Name="DownloadVideoBtn" Content="📥" Style="{StaticResource IconActionButton}" ToolTip="Download Video MP4 (D)" Margin="0,0,5,0" Click="DownloadVideoBtn_Click"/>

                                    <!-- 3. 📁 Folder Switcher -->
                                    <Button Content="📁" Style="{StaticResource IconActionButton}" ToolTip="Change Screenshot Folder" Margin="0,0,5,0" Click="ChangeFolder_Click"/>

                                    <!-- 4. ▶️/⏸️ Autoplay Toggle Switch -->
                                    <Button x:Name="AutoplayBtn" Content="▶️" Style="{StaticResource IconActionButton}" ToolTip="Toggle Autoplay Next Video" Margin="0,0,5,0" Click="AutoplayBtn_Click"/>

                                    <!-- 5. 🌙 Sleep Timer -->
                                    <Button x:Name="SleepTimerBtn" Content="🌙" Style="{StaticResource IconActionButton}" ToolTip="Sleep Timer" Margin="0,0,5,0" Click="SleepTimerBtn_Click"/>

                                    <!-- 5. ⭐ Favorite -->
                                    <Button x:Name="FavBtn" Content="⭐" Style="{StaticResource IconActionButton}" ToolTip="Favorite" Margin="0,0,5,0" Click="FavBtn_Click"/>

                                    <!-- 6. 🕒 Watch Later -->
                                    <Button x:Name="WatchLaterBtn" Content="🕒" Style="{StaticResource IconActionButton}" ToolTip="Watch Later" Margin="0,0,5,0" Click="WatchLaterBtn_Click"/>

                                    <!-- 7. ⏭️ Next Video -->
                                    <Button Content="⏭️" Style="{StaticResource IconActionButton}" ToolTip="Next Video (N)" Margin="0,0,5,0" Click="NextVideoBtn_Click"/>

                                    <!-- 8. ✨ AI Summarize & Copilot -->
                                    <Button x:Name="PlayerAiBtn" Content="✨" Style="{StaticResource IconActionButton}" ToolTip="AI Video Summarizer &amp; Assistant" Margin="0,0,5,0" Click="AiCopilotBtn_Click"/>

                                    <!-- 9. ⧉ POP-OUT FLOATING PLAYER -->
                                    <Button x:Name="PopOutBtn" Content="⧉" Style="{StaticResource IconActionButton}" ToolTip="Pop-out Floating Mini Player (Always on Top)" Margin="0,0,5,0" Click="PopOutPlayer_Click"/>

                                    <!-- 10. 🛠️ F12 DevTools -->
                                    <Button Content="🛠️" Style="{StaticResource IconActionButton}" ToolTip="Developer Tools (F12)" Margin="0,0,5,0" Click="DevToolsBtn_Click"/>

                                    <!-- 11. ⛶ Fullscreen -->
                                    <Button Content="⛶" Style="{StaticResource IconActionButton}" ToolTip="Fullscreen (F)" Click="FullscreenBtn_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </Grid>

                    <!-- C. SLEEP TIMER POPUP (HWnd Layered, floats above WebView2) -->
                    <Popup x:Name="SleepTimerPopup" AllowsTransparency="True" StaysOpen="False" Placement="Center" PlacementTarget="{Binding ElementName=PlayerView}">
                        <Border Width="320" Background="#1C1C26" BorderBrush="{StaticResource BorderHover}" BorderThickness="1.5" CornerRadius="16" Padding="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.8" Color="Black"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="🌙 Sleep Timer" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                    <Button Content="✕" Style="{StaticResource IconActionButton}" Width="24" Height="24" HorizontalAlignment="Right" Click="CloseSleepModal_Click"/>
                                </Grid>

                                <TextBlock x:Name="SleepSliderValueText" Text="30 minutes" Foreground="{StaticResource AccentGold}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6"/>

                                <Slider x:Name="SleepSlider" Minimum="5" Maximum="60" Value="30" SmallChange="5" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="5" Margin="0,10" ValueChanged="SleepSlider_ValueChanged"/>

                                <UniformGrid Columns="4" Margin="0,6,0,14">
                                    <Button Content="15m" Style="{StaticResource GlassButton}" Padding="4,4" Margin="2" Click="Preset15_Click"/>
                                    <Button Content="30m" Style="{StaticResource GlassButton}" Padding="4,4" Margin="2" Click="Preset30_Click"/>
                                    <Button Content="45m" Style="{StaticResource GlassButton}" Padding="4,4" Margin="2" Click="Preset45_Click"/>
                                    <Button Content="60m" Style="{StaticResource GlassButton}" Padding="4,4" Margin="2" Click="Preset60_Click"/>
                                </UniformGrid>

                                <Button Content="Start Timer" Style="{StaticResource RedAccentButton}" Click="StartSleepTimer_Click"/>
                                <Button x:Name="CancelSleepBtn" Content="Cancel Timer" Style="{StaticResource GlassButton}" Margin="0,6,0,0" Visibility="Collapsed" Click="CancelSleepTimer_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- D. FOLDER MANAGER POPUP (HWnd Layered, floats above WebView2) -->
                    <Popup x:Name="FolderPopup" AllowsTransparency="True" StaysOpen="False" Placement="Center" PlacementTarget="{Binding ElementName=PlayerView}">
                        <Border Width="380" Background="#1C1C26" BorderBrush="{StaticResource BorderHover}" BorderThickness="1.5" CornerRadius="16" Padding="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.8" Color="Black"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="📁 Screenshot Destination" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                    <Button Content="✕" Style="{StaticResource IconActionButton}" Width="24" Height="24" HorizontalAlignment="Right" Click="CloseFolderModal_Click"/>
                                </Grid>

                                <!-- Current Active Path Display -->
                                <Border Background="#14141A" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="CURRENT SAVE LOCATION" Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock x:Name="PopupCurrentFolderText" Text="Pictures\Vixz" Foreground="{StaticResource AccentGold}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Primary Action: Native Windows Folder Picker Dialog -->
                                <Button Content="📂 Browse &amp; Select Any Folder..." Style="{StaticResource RedAccentButton}" Margin="0,0,0,14" Click="BrowseAndSelectFolder_Click"/>

                                <TextBlock Text="Or choose a sub-folder album:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,6"/>

                                <ListBox x:Name="FolderListBox" Background="#14141A" BorderBrush="{StaticResource BorderSubtle}" Foreground="White" MaxHeight="110" Margin="0,0,0,10" SelectionChanged="FolderListBox_SelectionChanged"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewFolderInput" Background="#181822" Foreground="White" BorderBrush="{StaticResource BorderSubtle}" Padding="8,6" FontSize="12"/>
                                    <Button Grid.Column="1" Content="Add" Style="{StaticResource GlassButton}" Margin="6,0,0,0" Click="AddNewFolder_Click"/>
                                </Grid>

                                <Button Content="Open Folder in Windows Explorer ↗" Style="{StaticResource GlassButton}" Click="OpenFolder_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- End of Grid.Column 1 (Feed & Player) -->
                </Grid>

                <!-- Col 2: Dedicated Glassmorphic AI Copilot Drawer (Zero Overlap with Player Bar) -->
                <Border x:Name="AiCopilotPanel"
                        Grid.Column="2"
                        Width="360"
                        Background="#12121B"
                        BorderBrush="{StaticResource AccentGold}"
                        BorderThickness="1.5,0,0,0"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.85" Color="Black"/>
                    </Border.Effect>
                    <Grid Margin="16,14">
                        <Grid.RowDefinitions>
                            <!-- 0. Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- 1. Quick Action Chips -->
                            <RowDefinition Height="Auto"/>
                            <!-- 2. Chat / Response ScrollViewer -->
                            <RowDefinition Height="*"/>
                            <!-- 3. Bottom Input Deck -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✨ Vixz AI Copilot" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                <Border Background="#33FFD700" CornerRadius="8" Padding="6,2" Margin="8,0,0,0">
                                    <TextBlock Text="VOICE &amp; COMMANDS" Foreground="{StaticResource AccentGold}" FontSize="9" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <Button Content="✕" Style="{StaticResource IconActionButton}" Width="26" Height="26" HorizontalAlignment="Right" Click="CloseAiCopilot_Click"/>
                        </Grid>

                        <!-- Quick Action Suggestion Chips -->
                        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                            <Button Content="✨ Summarise Video" Style="{StaticResource GlassButton}" FontSize="11" Padding="8,4" Margin="0,0,4,4" Click="AiChipSummarize_Click"/>
                            <Button Content="▶️ Latest Benny Johnson" Style="{StaticResource GlassButton}" FontSize="11" Padding="8,4" Margin="0,0,4,4" Click="AiChipBenny_Click"/>
                            <Button Content="🌙 30m Sleep Timer" Style="{StaticResource GlassButton}" FontSize="11" Padding="8,4" Margin="0,0,4,4" Click="AiChipTimer_Click"/>
                            <Button Content="⚡ Today's Breaking News" Style="{StaticResource GlassButton}" FontSize="11" Padding="8,4" Margin="0,0,4,4" Click="AiChipNews_Click"/>
                        </WrapPanel>

                        <!-- Chat Stream & Response Cards -->
                        <ScrollViewer Grid.Row="2" x:Name="AiChatScrollViewer" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                            <StackPanel x:Name="AiMessageStack">
                                <!-- Welcome Message Card -->
                                <Border Background="#1A1A26" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="🤖 Hello! I am your Vixz AI Assistant." Foreground="White" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="You can ask me anything:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                                        <TextBlock Text="• 'Play the latest Benny Johnson video'&#x0a;• 'Summarise this video'&#x0a;• 'Skip 30 seconds' / 'Go back 10s'&#x0a;• 'Sleep timer for 25 mins'&#x0a;• 'Find AI news from today'" Foreground="{StaticResource AccentGold}" FontSize="11.5" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom Prompt Bar -->
                        <Border Grid.Row="3" Background="#181824" BorderBrush="{StaticResource BorderHover}" BorderThickness="1" CornerRadius="12" Padding="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AiPromptBox"
                                         Background="Transparent"
                                         Foreground="White"
                                         BorderThickness="0"
                                         FontSize="12.5"
                                         VerticalAlignment="Center"
                                         Margin="8,0"
                                         CaretBrush="{StaticResource AccentGold}"
                                         KeyDown="AiPromptBox_KeyDown"/>
                                <TextBlock Text="Ask AI or type a command..."
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="8,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=AiPromptBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="1"
                                        Content="➤"
                                        Style="{StaticResource RedAccentButton}"
                                        Width="32" Height="30"
                                        Padding="0"
                                        ToolTip="Send Command (Enter)"
                                        Click="AiSendBtn_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
