<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BgDarkPrimary" Color="#0B0B0E"/>
    <SolidColorBrush x:Key="BgDarkSecondary" Color="#131317"/>
    <SolidColorBrush x:Key="BgDarkCard" Color="#1A1A22"/>
    <SolidColorBrush x:Key="BgGlassCard" Color="#221F28"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="AccentRed" Color="#FF2A2A"/>
    <SolidColorBrush x:Key="AccentRedHover" Color="#FF4A4A"/>
    <SolidColorBrush x:Key="AccentGold" Color="#FFD700"/>
    <SolidColorBrush x:Key="AccentPurple" Color="#A855F7"/>

    <!-- Text & Borders -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="TextMuted" Color="#666666"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#28FFFFFF"/>
    <SolidColorBrush x:Key="BorderHover" Color="#55FFFFFF"/>

</ResourceDictionary>
